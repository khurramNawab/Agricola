# AgriCola Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/agricola
MONGODB_TEST_URI=mongodb://localhost:27017/agricola_test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=30d

# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ---------------------------------------------------------------------------
# Logistics provider. 'shiprocket' (default) or 'ekart' (previous provider, kept
# for rollback). Everything below in both blocks is read by utils/shipping.js.
SHIPPING_PROVIDER=shiprocket

# Shiprocket API — https://apidocs.shiprocket.in
# Credentials are a dedicated API user (Settings → API → Configure → Create an API
# user), NOT your dashboard login. The login call returns a bearer token valid 240h.
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_EMAIL=your-shiprocket-api-user@example.com
SHIPROCKET_PASSWORD=your-shiprocket-api-password
# Pickup-address nickname from Settings → Company → Pickup Addresses. Must match
# EXACTLY (case + spacing) or every booking fails with "Wrong Pickup location".
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: pin every booking to one courier id. Unset = cheapest serviceable courier
# (the same one quoted at checkout).
# SHIPROCKET_COURIER_ID=51
# Optional: tag orders to a specific Shiprocket channel (Settings → Channels).
# SHIPROCKET_CHANNEL_ID=
# Ask the courier for a pickup, and fetch the courier AWB label, right after booking.
SHIPROCKET_REQUEST_PICKUP=true
SHIPROCKET_GENERATE_LABEL=true
# Value of the custom header configured in Settings → API → Webhooks, where the URL
# must be https://<api-host>/api/v1/shipping/webhook/tracking — Shiprocket rejects any
# webhook URL containing "shiprocket", "kartrocket", "sr" or "kr". Our receiver
# compares the header against x-api-key / x-shiprocket-token / Authorization.
# Shiprocket does NOT HMAC-sign webhook bodies,
# so this shared token is the only thing protecting an endpoint that changes order
# status: with it unset the receiver refuses every request (503).
SHIPROCKET_WEBHOOK_TOKEN=your-shiprocket-webhook-token
# No Shiprocket sandbox exists. Set true to use built-in spec-shaped mock responses
# (no network calls) for local/staging testing. Set false to hit the live API.
SHIPROCKET_MOCK=false

# Seller / invoice identity (carrier-independent; falls back to the EKART_* values).
SELLER_NAME=AgriCola
SELLER_ADDRESS=123 Warehouse Street, Industrial Area, Mumbai
SELLER_GST_TIN=your-gstin

# ---------------------------------------------------------------------------
# Ekart (GoSwift/Elite) Logistics API — https://app.elite.ekartlogistics.in/api/docs
# Auth is client_id + username/password (a bearer token is fetched & cached, ~24h).
EKART_API_BASE_URL=https://app.elite.ekartlogistics.in
EKART_CLIENT_ID=your-ekart-client-id
EKART_USERNAME=your-ekart-username
EKART_PASSWORD=your-ekart-password
# 6-30 char shared secret. Ekart HMACs each webhook body with it; our receiver
# (POST /api/v1/shipping/webhook) verifies using the same value.
EKART_WEBHOOK_SECRET=your-ekart-webhook-secret
# Public URL Ekart should POST track_updated/shipment_created events to.
# Register it once with `npm run ekart:webhook` (scripts/registerEkartWebhook.js).
EKART_WEBHOOK_URL=https://api.agricola.co.in/api/v1/shipping/webhook
EKART_DEFAULT_SERVICE=standard
# No Ekart sandbox exists. Set true to use built-in spec-shaped mock responses
# (no network calls) for local/staging testing. Set false to hit the live API.
EKART_MOCK=true
# Auto-book a shipment with the active provider when an order's payment succeeds
AUTO_CREATE_SHIPMENT=true

# Seller / invoice identity required by the Ekart create-shipment API.
EKART_SELLER_NAME=AgriCola
EKART_SELLER_ADDRESS=123 Warehouse Street, Industrial Area, Mumbai
EKART_SELLER_GST_TIN=your-gstin
EKART_CATEGORY_OF_GOODS=Grocery
# Optional: if your pickup/return warehouse is pre-registered with Ekart, set its
# alias and only the alias is sent (Ekart autofills the full address).
# EKART_PICKUP_ALIAS=primary-warehouse
# EKART_RETURN_ALIAS=primary-warehouse

# Warehouse/Pickup Address Configuration.
# WAREHOUSE_PINCODE is sent as Shiprocket's pickup_postcode on every rate lookup —
# a wrong value silently mis-prices delivery, so keep it in sync with the real
# pickup address registered with the provider.
WAREHOUSE_NAME=AgriCola Warehouse
WAREHOUSE_PHONE=+919876543210
WAREHOUSE_ADDRESS_LINE_1=123 Warehouse Street, Industrial Area
WAREHOUSE_ADDRESS_LINE_2=Near Metro Station
WAREHOUSE_CITY=Mumbai
WAREHOUSE_STATE=Maharashtra
WAREHOUSE_PINCODE=400001
WAREHOUSE_COUNTRY=India

# Email — order confirmation (customer) + new-order notification (store), via SMTP (Zoho).
# Zoho: host smtp.zoho.in, port 587 (STARTTLS) or 465 (SSL). EMAIL_USER/PASS = your
# Zoho mailbox + app-specific password. EMAIL_FROM should be that same verified address.
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=587
EMAIL_USER=orders@agricola.co.in
EMAIL_PASS=your-zoho-app-password
EMAIL_FROM=AgriCola <orders@agricola.co.in>
# Where the store's new-order notifications go (falls back to NOTIFY_FALLBACK_EMAIL, then EMAIL_USER).
STORE_ORDER_EMAIL=orders@agricola.co.in
NOTIFY_FALLBACK_EMAIL=orders@agricola.co.in
# Logo shown in emails. Use a PNG — most email clients don't render SVG.
EMAIL_LOGO_URL=https://www.agricola.co.in/agricola_logo.png
# (Resend is no longer used — email now goes through the SMTP settings above.)

# Cloudinary Configuration (legacy — superseded by AWS S3 below)
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AWS S3 Configuration (admin image uploads) — programmatic IAM keys, NOT console login.
# The IAM user/role needs s3:PutObject + s3:DeleteObject on the bucket.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET=your-s3-bucket-name
# Optional: serve via CloudFront/custom domain instead of the default S3 URL.
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# SMS Configuration (for OTP and notifications)
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=AGRCLA

# Fast2SMS (legacy SMS OTP — superseded by Firebase phone auth below)
FAST2SMS_API_KEY=your-fast2sms-api-key
# DLT route (set both to send via a registered DLT header + OTP template):
# FAST2SMS_DLT_SENDER_ID=AGRICO
# FAST2SMS_DLT_MESSAGE_ID=123456

# Firebase Admin (phone-auth OTP) — verifies ID tokens from the client SDK.
# No DLT needed; Google delivers the SMS. Provide EITHER:
#   (a) a serviceAccountKey.json file in the backend root (gitignored), OR
#   (b) these three vars from that service-account JSON (PEM newlines as \n):
# FIREBASE_PROJECT_ID=agricola-xxxxx
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@agricola-xxxxx.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OTP Configuration
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Dev sandbox: log the OTP to the console instead of sending a real SMS. false for live.
OTP_DEV_MODE=false

# Admin auth (phone + password + OTP). Comma-separated +91 numbers seeded as
# admins on first login with ADMIN_DEFAULT_PASSWORD.
ADMIN_PHONES=+919876543210
ADMIN_DEFAULT_PASSWORD=change-this-strong-password

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Google Maps API (for address validation)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Security Configuration
BCRYPT_SALT_ROUNDS=12
# Comma-separated allowlist of frontend origins permitted to call the API.
# Production example: https://www.agricola.co.in,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Payment Gateway URLs
RAZORPAY_SUCCESS_URL=http://localhost:5173/payment/success
RAZORPAY_FAILURE_URL=http://localhost:5173/payment/failure

# Shipping Configuration
DEFAULT_SHIPPING_COST=50
FREE_SHIPPING_THRESHOLD=500
EXPRESS_SHIPPING_MULTIPLIER=1.5

# Parcel box used when a product has no dimensions of its own (the admin product form
# has no dimension fields, so this is the effective default for every shipment).
# Carriers bill the GREATER of actual and volumetric weight — Shiprocket's volumetric
# weight is L×W×H/5000 kg — so an over-sized default here silently inflates every
# shipping bill. Measure a real outer parcel and set these.
PARCEL_DEFAULT_LENGTH_CM=20
PARCEL_DEFAULT_WIDTH_CM=20
PARCEL_DEFAULT_HEIGHT_CM=10

# Tax Configuration
DEFAULT_GST_RATE=18
ESSENTIAL_GOODS_GST_RATE=5

# Order Configuration
ORDER_CANCELLATION_WINDOW=24
ORDER_RETURN_WINDOW=168
AUTO_CONFIRM_PAYMENT_ORDERS=true

# Admin Configuration
ADMIN_EMAIL=admin@agricola.com
ADMIN_PHONE=+919876543210

# Development Configuration
MOCK_PAYMENT_SUCCESS=false
MOCK_SHIPPING_API=false
ENABLE_API_DOCS=true
ENABLE_DEBUG_LOGS=true